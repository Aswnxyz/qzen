# Copy to `.env.local` and fill in real values. Never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Auth (better-auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── MCP ─────────────────────────────────────────────────────────────────────
MCP_RESOURCE_URL=

# ── Web Push notifications ──────────────────────────────────────────────────
# Generate a fresh pair with:
#
#     npx web-push generate-vapid-keys
#
# Paste the printed values below. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are
# a base64url key pair — the public key is served to the browser so it can
# subscribe; the PRIVATE key must stay on the server only.
#
# VAPID_SUBJECT identifies you to the push services and must be a mailto: or
# https: URL, e.g. mailto:you@example.com.
#
# Push notifications are disabled at runtime when any of these are missing:
# the app still builds and runs, and the subscribe endpoint reports 503.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
